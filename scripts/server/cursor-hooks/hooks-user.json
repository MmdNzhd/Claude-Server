{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/laptop-exec-session.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./hooks/laptop-exec-guard-wrap.sh"
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/laptop-exec-guard-wrap.sh",
        "matcher": "Grep|Glob|Read|Write|Edit|EditNotebook|StrReplace|Delete|Task"
      }
    ]
  }
}
